<div{{ attributes }}>
    <input type='text' data-model="nom" placeholder="Rechercher un jeu ..." style="margin:20px; padding:10px">

    {% if jeux is empty %}
    <p>Aucun jeu trouvé.</p>
    {% else %}
    <div style="display: flex; flex-wrap: wrap; gap: 30px; justify-content: space-around">
        {% for jeu in jeux %}
        <div style="border: 2px solid black; margin-bottom: 10px; padding: 10px; width: 200px; border-radius: 5px;">
            <h3>{{ jeu.titre }}</h3>
            <p>{{ jeu.description | raw }}</p>
            <p>Nombre de joueurs : {{ jeu.nbJoueurs }}</p>
            <p>Durée moyenne : {{ jeu.dureeMoyenne }}</p>
            <p>Âge minimum : {{ jeu.ageMinimum }}</p>
        </div>
        {% endfor %}
    </div>
{% endif %}
</div>
